name = "moyunijieshi1/moon-securitytxt"

version = "0.1.0"

readme = "README.md"

license = "Apache-2.0"

description = "RFC 9116 security.txt parser, validator, generator and audit toolkit for MoonBit."

repository = "https://github.com/moyunijieshi1/moon-securitytxt"

keywords = [
  "security-txt",
  "securitytxt",
  "rfc9116",
  "parser",
  "validator",
  "audit",
  "moonbit",
]

warnings = "-reserved_keyword"

options(
  exclude: [ "_build/**" ],
  max_line_width: 120,
)
